<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>A.R.I.E.S. // Radio Room</title>
  <meta name="description" content="A.R.I.E.S. radio room: transmissions and updates from the station.">
  <meta name="theme-color" content="#16151b">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%2316151b'/%3E%3Cpath fill-rule='evenodd' d='M16 5 6 27h4l2-5h8l2 5h4L16 5zm0 9 3 6h-6l3-6z' fill='%23a78bfa'/%3E%3C/svg%3E">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/radio/radio.css">
  <script src="/theme.js"></script>
  <script src="/script.js" defer></script>
</head>
<body>
  <canvas id="starfield" aria-hidden="true"></canvas>
  <a class="skip" href="#main">Skip to main content</a>

  <header class="topbar">
    <div class="wrap bar">
      <a class="brand" href="/" aria-label="A.R.I.E.S. docking bay">
        <span class="brand-name">A.R.I.E.S.</span>
        <span class="brand-sub">Autonomous Research, Intelligence &amp; Exploration Station</span>
      </a>
      <nav class="nav" aria-label="Station sections">
        <ul>
          <li><a href="/">Docking Bay</a></li>
          <li><a href="/about/">Crew Quarters</a></li>
          <li><a href="/radio/" aria-current="page">Radio Room</a></li>
          <li><a href="/crew-log/">Crew Log</a></li>
        </ul>
      </nav>
      <button type="button" id="theme-toggle" class="btn" aria-pressed="false">
        <span class="ico" aria-hidden="true">&#9680;</span><span>Light theme</span>
      </button>
    </div>
  </header>

  <main id="main">
    <div class="wrap">
      <div class="radio-hero">
        <section>
          <p class="eyebrow">Deck 03 // Communications</p>
          <h1>Radio Room</h1>
          <p class="lede">
            <strong>Transmissions from the station.</strong> Short notes about what is being built,
            what broke, and what was learned along the way. Written by hand, newest first.
          </p>
        </section>

        <section class="panel tuner" aria-labelledby="tuner-h">
          <h2 id="tuner-h">Receiver</h2>
          <div class="freq" aria-hidden="true">
            <span class="freq-num">90.1</span>
            <span class="freq-unit">MHz</span>
          </div>
          <div class="dial" aria-hidden="true">
            <span class="needle"></span>
            <div class="labels"><span>80</span><span>90</span><span>100</span><span>110</span></div>
          </div>
          <div class="eq" aria-hidden="true">
            <span style="--h:.30;--d:-.2s;--s:1.7s"></span>
            <span style="--h:.55;--d:-.9s;--s:1.3s"></span>
            <span style="--h:.40;--d:-.5s;--s:1.9s"></span>
            <span style="--h:.75;--d:-1.1s;--s:1.5s" class="hot"></span>
            <span style="--h:.35;--d:-.7s;--s:1.2s"></span>
            <span style="--h:.60;--d:-1.4s;--s:1.8s"></span>
            <span style="--h:.45;--d:-.3s;--s:1.4s"></span>
            <span style="--h:.85;--d:-1.0s;--s:1.6s" class="hot"></span>
            <span style="--h:.50;--d:-.6s;--s:2.0s"></span>
            <span style="--h:.30;--d:-1.3s;--s:1.3s"></span>
            <span style="--h:.65;--d:-.1s;--s:1.7s"></span>
            <span style="--h:.40;--d:-.8s;--s:1.5s"></span>
            <span style="--h:.70;--d:-1.2s;--s:1.2s" class="hot"></span>
            <span style="--h:.35;--d:-.4s;--s:1.9s"></span>
            <span style="--h:.55;--d:-1.5s;--s:1.4s"></span>
            <span style="--h:.45;--d:-.9s;--s:1.6s"></span>
            <span style="--h:.30;--d:-.2s;--s:1.8s"></span>
            <span style="--h:.60;--d:-1.1s;--s:1.3s"></span>
          </div>
          <dl class="readouts">
            <div><dt>Channel</dt><dd>Station broadcast</dd></div>
            <div><dt>Signal</dt><dd class="val-ok"><span class="strength" aria-hidden="true" style="display:inline-flex;vertical-align:middle"><i></i><i></i><i></i><i></i><i></i></span><span class="sr-only">Strong</span></dd></div>
            <div><dt>Transmissions</dt><dd>{{ transmissions|length }} on file</dd></div>
          </dl>
        </section>
      </div>

      <h2 class="section-title">Transmission log</h2>
      <ol class="log" reversed>
        {% for tx in transmissions %}
        <li>
          <article class="tx" aria-labelledby="tx{{ tx.num }}-h">
            <p class="tx-meta">
              <span class="id">TX-{{ "%03d"|format(tx.num) }}</span>
              <time datetime="{{ tx.date.isoformat() }}">{{ tx.date_human }}</time>
              <span>Channel: station</span>
            </p>
            <h3 id="tx{{ tx.num }}-h">{{ tx.title }}</h3>
            {{ tx.html|safe }}
            {% if tx.tags %}
            <ul class="tags" aria-label="Tags">
              {% for tag in tx.tags %}<li>{{ tag }}</li>{% endfor %}
            </ul>
            {% endif %}
          </article>
        </li>
        {% endfor %}
      </ol>
      <p class="log-end">End of log // more transmissions soon</p>
    </div>
  </main>

  <footer class="footer">
    <div class="wrap">
      <span>A.R.I.E.S. // &copy; 2026 pixal.ro</span>
      <span>Static site. No trackers, no cookies.</span>
    </div>
  </footer>
</body>
</html>
